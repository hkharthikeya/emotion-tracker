# Django Core Configuration
DJANGO_SECRET_KEY=emoticam-django-secret-key-change-in-production-2026-secure
DEBUG=True
ALLOWED_HOSTS=*

# ESP32-CAM Stream Configuration
# Format: http://<ESP32_IP_ADDRESS>
ESP32_CAMERA_URL=http://192.168.1.100

# Video Pipeline Parameters
CAMERA_FPS=15
IMAGE_WIDTH=640
IMAGE_HEIGHT=480
JPEG_QUALITY=80
PROCESSING_INTERVAL=0.04

# Model Configuration
EMOTION_MODEL_PATH=models/emotion-ferplus-8.onnx
FACE_DETECTION_MIN_SIZE=60
FACE_CONFIDENCE_THRESHOLD=0.35
